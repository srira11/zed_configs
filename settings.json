// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  "collaboration_panel": {
    "dock": "right"
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "fast": false,
        "agent": "default",
        "mode": "auto",
        "effort": "high",
        "model": "opus"
      },
      "type": "registry"
    }
  },
  "gutter": {
    "line_numbers": true
  },
  "cli_default_open_behavior": "existing_window",
  "terminal": {
    "font_size": 13.0,
    "font_family": "Monaco"
  },
  "outline_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "right"
  },
  "git_hosting_providers": [
    {
      "provider": "github",
      "name": "GitHub",
      "base_url": "https://github.com"
    }
  ],
  "project_panel": {
    "dock": "left"
  },
  "buffer_line_height": "comfortable",
  "auto_update": true,
  "code_actions_on_format": {
    "source.fixAll.eslint": true
  },
  "edit_predictions": {
    "provider": "copilot",
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    },
    "enabled_in_text_threads": false
  },
  "show_edit_predictions": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Colored Zed Icons Theme Dark",
    "dark": "Colored Zed Icons Theme Dark"
  },
  "agent": {
    "thinking_display": "always_expanded",
    "tool_permissions": {
      "tools": {
        "mcp:atlassian-mcp-server:getJiraIssue": {
          "default": "allow"
        },
        "mcp:atlassian-mcp-server:editJiraIssue": {
          "default": "allow"
        },
        "mcp:atlassian-mcp-server:createJiraIssue": {
          "default": "allow"
        }
      }
    },
    "use_modifier_to_send": true,
    "show_turn_stats": true,
    "play_sound_when_agent_done": "always",
    "sidebar_side": "right",
    "dock": "right",
    "favorite_models": [
      {
        "provider": "google",
        "model": "gemini-2.5-flash",
        "enable_thinking": false
      }
    ],
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "anthropic",
      "model": "claude-sonnet-4-6"
    },
    "default_profile": "ask",
    "model_parameters": [],
    "profiles": {
      "ask": {
        "name": "Ask",
        "tools": {
          "search_web": true,
          "diagnostics": true,
          "fetch": true,
          "list_directory": true,
          "project_notifications": false,
          "now": true,
          "find_path": true,
          "read_file": true,
          "open": true,
          "grep": true,
          "subagent": true,
          "thinking": true
        },
        "enable_all_context_servers": false,
        "context_servers": {
          "atlassian-mcp-server": {
            "tools": {
              "updateConfluencePage": true,
              "transitionJiraIssue": true,
              "searchJiraIssuesUsingJql": true,
              "searchConfluenceUsingCql": true,
              "search": true,
              "lookupJiraAccountId": true,
              "getVisibleJiraProjects": true,
              "getTransitionsForJiraIssue": true,
              "getJiraProjectIssueTypesMetadata": true,
              "getPagesInConfluenceSpace": true,
              "getJiraIssueTypeMetaWithFields": true,
              "getJiraIssueRemoteIssueLinks": true,
              "getJiraIssue": true,
              "getConfluenceSpaces": true,
              "getConfluencePageInlineComments": true,
              "getConfluencePageFooterComments": true,
              "getConfluencePageDescendants": true,
              "getConfluencePage": true,
              "getAccessibleAtlassianResources": true,
              "fetch": true,
              "editJiraIssue": true,
              "createJiraIssue": true,
              "createConfluencePage": true,
              "createConfluenceInlineComment": true,
              "createConfluenceFooterComment": true,
              "atlassianUserInfo": true,
              "addWorklogToJiraIssue": true,
              "addCommentToJiraIssue": true
            }
          }
        }
      }
    }
  },
  "buffer_font_family": "Monaco",
  "ui_font_family": "Monaco",
  "base_keymap": "JetBrains",
  "languages": {
    "TSX": {
      "show_edit_predictions": false
    },
    "Groovy": {
      "show_edit_predictions": false
    },
    "TypeScript": {
      "show_edit_predictions": false
    },
    "Vue.js": {
      "show_edit_predictions": false
    },
    "Ruby": {
      "show_edit_predictions": true,
      "language_servers": ["rubocop", "!solargraph", "!ruby-lsp", "!sorbet", "!steep", "!fuzzy-ruby-server", "..."]
    }
  },
  "lsp": {
    "ruby-lsp": {
      "settings": {
        "use_bundler": false
      },
    },
    "solargraph": {
      "settings": {
        "use_bundler": false
      }
    },
    "rubocop": {
      "settings": {
        "use_bundler": false
      }
    }
  },
  "theme": "GitHub Dark",
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "formatter": [],
  "tab_size": 2,
  "vim_mode": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "ui_font_size": 16,
  "buffer_font_size": 13.0,
  "context_servers": {
    "mcp-server-github": {
      "enabled": true,
      "remote": false,
      "settings": {
        "github_personal_access_token": "github-key"
      }
    },
    "atlassian-mcp-server": {
      "env": {},
      "enabled": true,
      "remote": false,
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.atlassian.com/v1/mcp"
      ]
    },
    "aikido-mcp-server": {
      "env": {
        "AIKIDO_API_KEY": "aikido-key"
      },
      "enabled": true,
      "remote": false,
      "command": "npx",
      "args": [
        "-y",
        "@aikidosec/mcp",
      ]
    }
  }
}
